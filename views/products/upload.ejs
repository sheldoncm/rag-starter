<!--
 RD4.3 | LESSON: multipart/form-data
 Required when an HTML form uploads a file.
-->
<h1>Upload PDF</h1>
<h3><%= product.name %></h3>

<form method="POST"
      action="/products/<%= product.product_id %>/upload"
      enctype="multipart/form-data">

  <div class="mb-3">
    <label class="form-label">Select PDF (maximum 10 MB)</label>
    <input class="form-control"
           type="file"
           name="pdf"
           accept=".pdf,application/pdf"
           required>
  </div>

  <button class="btn btn-primary" type="submit">
    Upload PDF
  </button>
</form>

<p class="mt-3">
  <a href="/products/<%= product.product_id %>">Cancel</a>
</p>
