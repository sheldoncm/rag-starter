<!-- RD4.3 | VIEW | PRODUCT DETAILS -->
<h1><%= product.name %></h1>

<p><%= product.description || 'No description' %></p>

<% if (product.pdf_id) { %>
  <p><strong>PDF:</strong> <%= product.original_filename %></p>
  <p><strong>Uploaded:</strong> <%= product.uploaded_at %></p>
  <a class="btn btn-secondary"
     href="/products/<%= product.product_id %>/upload">
    Replace PDF
  </a>
<% } else { %>
  <p>No PDF uploaded</p>
  <a class="btn btn-primary"
     href="/products/<%= product.product_id %>/upload">
    Upload PDF
  </a>
<% } %>

<p class="mt-3"><a href="/products">Back to products</a></p>


<!-- RD4.3 | PART E | CHAT WITH PDF -->
<% if (product.pdf_id) { %>
  <hr>
  <h2>Ask a Question About This Product</h2>

  <form id="question-form" class="mb-3">
    <input id="question-input" class="form-control mb-2"
           type="text"
           placeholder="Ask a question about this product..."
           maxlength="2000" required>
    <button class="btn btn-primary" type="submit">Ask</button>
  </form>

  <div id="answer-container" class="alert alert-light"
       style="display:none">
    <h3>Answer</h3>
    <p id="answer-text" style="white-space:pre-wrap"></p>
  </div>

  <script>
    // LESSON: Browser JavaScript calls the Express chat API.
    // SEARCH KEYWORDS: fetch, POST, JSON, DOM, async
    const form = document.getElementById('question-form');
    const input = document.getElementById('question-input');
    const container = document.getElementById('answer-container');
    const answerText = document.getElementById('answer-text');
    const productId = <%= product.product_id %>;

    form.addEventListener('submit', async event => {
      event.preventDefault();
      container.style.display = 'block';
      answerText.textContent = 'Thinking...';

      try {
        const response = await fetch(`/products/${productId}/chat`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ question: input.value.trim() })
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.error || 'Request failed');
        }

        answerText.textContent = data.answer;
      } catch (error) {
        answerText.textContent = 'Error: ' + error.message;
      }
    });
  </script>
<% } %>
